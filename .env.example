# Nexus Gaming Platform Environment Variables

# ==============================================================================
# Supabase Configuration (Authentication, Database, Realtime, Storage)
# ==============================================================================
# Create a free project at https://supabase.com
# Found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Note: Can be either the Supabase Anon Key or the new Publishable Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Service role secret key (Server-side ONLY, never expose to browser)
# Found in Supabase Project Settings > API > service_role key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Optional: Public Application URL for OAuth/Email redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# LiveKit WebRTC Configuration (Voice, Video, Screen Sharing - Phase 5)
# ==============================================================================
# Create a free cloud project at https://cloud.livekit.io or self-host LiveKit
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
