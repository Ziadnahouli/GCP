{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "src-tauri",
          "format": "url",
          "env": "TAURI_SERVICE_URL"
        }
      ]
    },
    "src-tauri": {
      "root": "desktop/src-tauri",
      "runtime": "rust"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
